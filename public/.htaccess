<IfModule mod_mime.c>
  AddType application/javascript .js .mjs
  AddType text/css .css
  AddType application/json .json
  AddType application/manifest+json .webmanifest
  AddType image/svg+xml .svg
  AddType image/webp .webp
  AddType font/woff2 .woff2
  AddType font/woff .woff
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType application/manifest+json "access plus 0 seconds"
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType text/javascript "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType image/x-icon "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType font/woff "access plus 1 year"
</IfModule>

<IfModule mod_headers.c>
  # Long-term 1-year immutable caching for static & content-hashed assets (works on Apache + Hostinger LiteSpeed)
  <FilesMatch "\.(js|mjs|css|webp|woff2|woff|png|jpe?g|svg|ico)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>

  # Never cache HTML documents or Web App Manifest so browsers always receive fresh hashed asset references
  <FilesMatch "\.(html|webmanifest)$">
    Header set Cache-Control "no-cache, no-store, must-revalidate, max-age=0"
    Header set Pragma "no-cache"
    Header set Expires "0"
  </FilesMatch>

  # Never cache Service Worker entry files and strip ETag so PWA updates activate cleanly
  <FilesMatch "^(sw|registerSW)\.js$">
    Header set Cache-Control "no-cache, no-store, must-revalidate, max-age=0"
    Header set Pragma "no-cache"
    Header set Expires "0"
    Header unset ETag
    FileETag None
  </FilesMatch>
</IfModule>

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Consolidate tatkhalsa.in/pothi to the standalone pothi.tatkhalsa.in app
  RewriteCond %{HTTP_HOST} ^(www\.)?tatkhalsa\.in$ [NC]
  RewriteRule ^pothi(?:/(.*))?$ https://pothi.tatkhalsa.in/$1 [R=301,L]

  # Redirect /pothi on pothi.tatkhalsa.in directly to root
  RewriteRule ^pothi(?:/(.*))?$ /$1 [R=301,L]

  # Serve existing files and directories directly
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # Never rewrite missing hashed assets to index.html (prevents text/html MIME errors)
  RewriteRule ^assets/ - [R=404,L]
  RewriteRule \.(js|mjs|css|map|json|webmanifest|svg|png|jpe?g|webp|gif|ico|woff2|woff|xml|txt)$ - [R=404,L]

  # SPA fallback for client routes (/searcher, /gurbani, /gutka, /reader, /pothi-present)
  RewriteRule ^ /index.html [L]
</IfModule>
