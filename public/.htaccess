<IfModule mod_mime.c>
  AddType application/javascript .js .mjs
  AddType text/css .css
  AddType application/json .json
  AddType font/woff2 .woff2
  AddType font/woff .woff
  AddType font/ttf .ttf
  AddType image/svg+xml .svg
  AddType image/webp .webp
</IfModule>

<IfModule mod_headers.c>
  # Never cache HTML documents so browsers always receive fresh hashed asset references
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache, no-store, must-revalidate, max-age=0"
    Header set Pragma "no-cache"
    Header set Expires "0"
  </FilesMatch>

  # Never cache sw.js and strip ETag so legacy service workers unregister immediately
  <FilesMatch "^sw\.js$">
    Header set Cache-Control "no-cache, no-store, must-revalidate, max-age=0"
    Header set Pragma "no-cache"
    Header set Expires "0"
    Header unset ETag
    FileETag None
  </FilesMatch>

  # Long-term immutable caching strictly for Vite content-hashed files under /assets/*
  <If "%{REQUEST_URI} =~ m#^/assets/#">
    <FilesMatch "\.(js|mjs|css|webp|png|jpe?g|svg|woff2|woff|ttf|ico)$">
      Header set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>
  </If>
</IfModule>

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Serve existing files and directories directly
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # Never rewrite missing hashed assets to index.html (prevents text/html MIME errors)
  RewriteRule ^assets/ - [R=404,L]
  RewriteRule \.(js|mjs|css|map|json|woff2?|ttf|eot|svg|png|jpe?g|webp|gif|ico|xml|txt)$ - [R=404,L]

  # SPA fallback for client routes (/searcher, /gurbani, /gutka, /reader, /pothi-present)
  RewriteRule ^ /index.html [L]
</IfModule>
